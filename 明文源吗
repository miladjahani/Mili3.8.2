				if (latestVersion && latestVersion !== CURRENT_VERSION) {
					const l = latestVersion.split('.').map(Number);
					const c = CURRENT_VERSION.split('.').map(Number);
					for (let i = 0; i < Math.max(l.length, c.length); i++) {
