        if (result.ok) {
          verifiedProxies.push({ ...candidate, ...result });
        } else {
          const reason = String(result.error || 'unknown').split('-')[0];
          failures[reason] = (failures[reason] || 0) + 1;
        }
      }, scanDeadline);

