const PROXY_FEED_REGISTRY = [
  ...SOCKS5_FEEDS.map(path => ({ url: raw(path), kind: 'socks5', scope: 'global' })),
  ...HTTP_FEEDS.map(path => ({ url: raw(path), kind: 'http', scope: 'global' })),
