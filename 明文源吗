        await updateUser(env, targetUser.id, { config: { p: proxyIp } }, clientIp);
        return jsonResponse({ success: true, p: proxyIp, userId: targetUser.id, message: `آدرس واسط کاربر «${targetUser.username}» روی ${proxyIp} تنظیم شد` });
      }

      if (targetUser && target === 's') {
        const item = items[0] || {};
        const proxyUrl = String(item.proxy || '').trim();
        if (!proxyUrl) return jsonResponse({ success: false, message: 'پروکسی معتبری ارسال نشد' }, 400);
        await updateUser(env, targetUser.id, { config: { s: proxyUrl } }, clientIp);
        return jsonResponse({ success: true, s: proxyUrl, userId: targetUser.id, message: 'پروکسی خروجی برای این کاربر تنظیم شد' });
      }      if (target === 'p') {
        const item = items[0] || {};
        const host = String(item.ip || item.proxy || '').trim();
        const port = parseInt(item.port || 443, 10) || 443;
        if (!host || (!isValidIpAddress(host) && !isValidDomain(host))) {
          return jsonResponse({ success: false, message: 'آدرس واسط معتبری ارسال نشد' }, 400);
        }
        const proxyIp = (host.includes(':') ? `[${host}]` : host) + ':' + port;
        await saveGlobalConfig(env, { p: proxyIp });
        return jsonResponse({ success: true, p: proxyIp, message: `آدرس واسط روی ${proxyIp} تنظیم شد` });
      }

      if (target === 's') {
        const item = items[0] || { };
        const proxyUrl = String(item.proxy || '').trim();
        if (!proxyUrl) return jsonResponse({ success: false, message: 'پروکسی معتبری ارسال نشد' }, 400);
        await saveGlobalConfig(env, { s: proxyUrl });
        return jsonResponse({ success: true, s: proxyUrl, message: 'پروکسی خروجی (s) تنظیم شد' });
      }

      if (target === 'yx') {
        const list = parseYxArray(cfg.yx || '');
        let added = 0;
        for (const item of items) {
          const ip = String(item?.ip || '').trim();
          const port = parseInt(item?.port || 443, 10) || 443;
          if (!ip || (!isValidIpAddress(ip) && !isValidDomain(ip))) continue;
          if (list.some(x => x.ip === ip && x.port === port)) continue;
          list.push({ ip, port, name: String(item?.name || ip) });
          added++;
        }
        if (added > 0) await saveGlobalConfig(env, { yx: serializeYxArray(list) });
        return jsonResponse({
          success: added > 0,
          added,
          total: list.length,
          message: added > 0 ? `${added} آدرس به آدرس‌های دستی اضافه شد` : 'آدرس جدیدی برای افزودن نبود'
        });
      }

      return jsonResponse({ success: false, message: 'مقصد نتیجه نامعتبر است' }, 400);
    } catch (err) {
      return jsonResponse({ success: false, message: 'خطا در اعمال نتیجه اسکن: ' + (err?.message || err) }, 500);
    }
  }

  return jsonResponse({ error: 'Endpoint not found' }, 404);
}

// مدیریت ریجن کلودفلر ورکر (/api/placement)
async function handlePlacementApi(request, env) {
  if (request.method === 'OPTIONS') return jsonResponse({ ok: true });
  const clientIp = request.headers.get('CF-Connecting-IP') || '127.0.0.1';
  const cfg = await loadGlobalConfig(env);
  const hostScriptName = new URL(request.url).hostname;

  if (request.method === 'GET') {
    const status = await getWorkerPlacementStatus(cfg, env, { hostScriptName });
    return jsonResponse(status, status.success ? 200 : 400);
  }

  if (request.method === 'POST') {
    let body = {};
    try { body = await request.json(); } catch (_e) {}
    const action = String(body?.action || 'update').toLowerCase();
    const providedToken = String(body?.cf_token || body?.token || '').trim();

    if (action === 'status') {
      const status = await getWorkerPlacementStatus(cfg, env, { token: providedToken, hostScriptName });
      if (status.success && providedToken) {
        await saveGlobalConfig(env, { cfApiToken: providedToken });
      }
      return jsonResponse(status, status.success ? 200 : 400);
    }

    const region = String(body?.region || 'smart').trim().toLowerCase();
    const iso = String(body?.iso || '').trim().toUpperCase();
    const tokenToUse = providedToken || String(cfg.cfApiToken || env?.CF_API_TOKEN || env?.CLOUDFLARE_API_TOKEN || '').trim();

    // اگر توکن کلودفلر نداریم ولی کاربر می‌خواهد ریجن لوکال (wk) را ذخیره کند یا توکن بدهد
    if (!tokenToUse && body?.local_only === true) {
      const saved = await saveGlobalConfig(env, { workerPlacement: region, wk: iso });
      return jsonResponse({
        success: true,
        localOnly: true,
        placement: region,
        iso,
        config: saved,
        message: `ریجن «${region}» در تنظیمات پنل ذخیره شد.`
      });
    }

    const res = await updateWorkerPlacement(cfg, env, {
      token: tokenToUse,
      region,
      iso,
      hostScriptName
    });
    if (res.success) {
      const patch = { workerPlacement: region, wk: iso };
      if (providedToken) patch.cfApiToken = providedToken;
      if (res.accountId) patch.cfAccountId = res.accountId;
      if (res.scriptName) patch.cfScriptName = res.scriptName;
      await saveGlobalConfig(env, patch);
      await addAuditLog(env, 'تغییر ریجن پنل', `ریجن: ${region} (${iso || 'AUTO'})`, clientIp).catch(() => {});
    }
    return jsonResponse(res, res.success ? 200 : 400);
  }

  return jsonResponse({ error: 'Method not allowed' }, 405);
}


